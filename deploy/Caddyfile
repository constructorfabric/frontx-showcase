# The edge in front of the site image (deploy/docker-compose.yml): TLS and the domain once they exist, the sub-path mount, and the deploy webhook's address. The site image serves plain HTTP on site:8080 and always sees the site at its root.

# Enabled by: the production domain. Uncomment and name the address that receives certificate notices.
# {
# 	email <operator address>
# }

# Local run: http://localhost:8080/ serves the site at the root and http://localhost:8080/frontx/ under a sub-path. The canonical addresses carry the origin the image was built with: SITE_ORIGIN=http://localhost:8080/frontx builds the image for the sub-path.
http://localhost, http://127.0.0.1 {
	header -Server
	redir /frontx /frontx/{?query} 308
	handle_path /frontx/* {
		reverse_proxy site:8080
	}
	handle {
		reverse_proxy site:8080
	}
	# An error the edge answers itself (the site still starting) skips the deferred deletion above.
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

