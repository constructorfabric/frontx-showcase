      {
        "token": "--background",
        "value": "#ffffff",
        "v2": "#ffffff",
        "role": "Page background"
      },
      {
        "token": "--foreground",
        "value": "#152440",
        "v2": "#152440",
        "role": "Ink of headings and kit component text"
      },
      {
        "token": "--popover-foreground",
        "value": "#152440",
        "v2": "#17212d",
        "reason": "V2 brands its page ink only inside its page wrapper, so its popups, rendered outside that wrapper, take its root ink #17212d. The site draws popup text in the same brand ink as the page, so a popup reads as part of it",
        "role": "Text of popups and overlays: menus, listboxes, popovers, dialogs, sheets and toasts"
      },
      {
        "token": "--muted",
        "value": "#f1f5ff",
        "v2": "#f1f5ff",
        "role": "Pale band behind the kit showcase and muted surfaces"
      },
      {
        "token": "--muted-foreground",
        "value": "#5c6b84",
        "v2": "#5c6b84",
        "role": "Leads and secondary text"
      },
      {
        "token": "--border",
        "value": "#e0e7f2",
        "v2": "#e0e7f2",
        "role": "Card and section lines"
      },
      {
        "token": "--surface",
        "value": "#f7f9fd",
        "v2": "#f7f9fd",
        "role": "Info cards and quiet panels"
      },
      {
        "token": "--accent",
        "value": "#edf3ff",
        "v2": "#edf3ff",
        "role": "Active rail item and accent washes"
      },
      {
        "token": "--accent-foreground",
        "value": "#0546cc",
        "v2": "#0756f5",
        "reason": "V2 draws its active rail item in the brand blue on #edf2ff (5.16:1); the site keeps a deeper blue for a wider margin (6.85:1 on --accent)",
        "role": "Text on the accent wash"
      },
      {
        "token": "--info-soft",
        "value": "#eef4ff",
        "v2": "#eef4ff",
        "role": "Call-to-action box background"
      },
      {
        "token": "--secondary",
        "value": null,
        "v2": "#edf1f8",
        "reason": "Not adopted: V2's product-layer value; the site keeps the kit's secondary surface, so kit secondary controls look as the kit ships them",
        "role": "Secondary surface of kit controls"
      },
      {
        "token": "--secondary-foreground",
        "value": null,
        "v2": "#283d60",
        "reason": "Not adopted, with --secondary",
        "role": "Text on the secondary surface"
      },
      {
        "token": "--chart-1",
        "value": null,
        "v2": "#0756f5",
        "reason": "Not adopted: V2 recolours the series on its home page only; the site's kit charts keep the kit's series colours",
        "role": "First chart series"
      },
      {
        "token": "--chart-2",
        "value": null,
        "v2": "#aa9af2",
        "reason": "Not adopted, with --chart-1",
        "role": "Second chart series"
      },
      {
        "token": "--chart-3",
        "value": null,
        "v2": "#648de9",
        "reason": "Not adopted, with --chart-1",
        "role": "Third chart series"
      }
