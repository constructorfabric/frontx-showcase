{
  "$comment": "The brand of the FrontX site, the single source of src/tokens.css, src/theme.ts and the token table of the brand guideline (npm run brand:generate). Each row: token, our value (null: V2 value recorded, not adopted), the V2 value measured on the design reference (null: V2 has none), the reason for any difference, and the role. Pairs: background and text tokens drawn together, held at 4.5:1 by brand:check.",
  "light": {
    "appearance": "light",
    "overrides": [
      {
        "token": "--primary",
        "value": "#0756f5",
        "v2": "#0756f5",
        "role": "Brand blue: primary buttons, the hero band, active navigation"
      },
      {
        "token": "--primary-hover",
        "value": "color-mix(in oklab, var(--primary) 80%, var(--foreground))",
        "v2": "#2668c5",
        "reason": "V2 keeps the kit's hover shade. The site derives its hover from the brand blue (create-theme rule): mixed toward the brand ink it renders #0f4dce, a step darker than the brand blue, at 7.06:1 under white text",
        "role": "Hover of the brand blue"
      },
      {
        "token": "--primary-foreground",
        "value": "#ffffff",
        "v2": "#ffffff",
        "role": "Text and icons on the brand blue"
      },
      {
        "token": "--primary-ring",
        "value": "#0756f5",
        "v2": "#2668c5",
        "reason": "V2 keeps the kit's ring shade on this token and rings its own controls through --ring in the brand blue; the site rings every control in the brand blue",
        "role": "Focus ring of primary controls"
      },
      {
        "token": "--ring",
        "value": "#0756f5",
        "v2": "#0756f5",
        "role": "Focus ring"
      },
      {
        "token": "--link-foreground",
        "value": "#0756f5",
        "v2": "#0756f5",
        "role": "Inline link ink (V2 draws its links in the brand blue)"
