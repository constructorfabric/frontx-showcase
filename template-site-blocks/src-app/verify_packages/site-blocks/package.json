{
  "name": "@gears-frontx/site-blocks",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "The FrontX site's blocks: section-level compositions built only from @gears-frontx/ui-kit components, kit candidates, brand art and tokens, with layout-only styles and content-only props, plus the layout tokens they share. Each block is its own entry point (`@gears-frontx/site-blocks/<Block>`). Delivered by @gears-frontx/frontx-template-site-blocks.",
  "license": "Apache-2.0",
  "exports": {
    "./document.css": "./src/document.css",
    "./layout.css": "./src/layout.css",
    "./showcase": "./src/showcase.ts",
    "./*": "./src/blocks/*/index.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false"
  },
  "dependencies": {
    "@gears-frontx/kit-candidates": "0.1.0-alpha.0",
    "@gears-frontx/site-brand": "0.1.0-alpha.0",
    "@gears-frontx/ui-kit": "0.4.0",
    "lucide-react": "1.33.0"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.0.3",
    "axe-core": "4.13.0",
    "jsdom": "26.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.4"
  }
}
