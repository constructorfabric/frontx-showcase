              "  createRoute({ getParentRoute: () => rootRoute, path: '/routing', component: RoutingPage }),",
              "]);",
              "",
              "// in the lifecycle, with app = createFrontX().use(microfrontends({ typeSystem: gtsPlugin })).build()",
