{
  "$comment": "Hand-written structure of the templates screen; scripts/site-data.mjs merges it with each template's manifest and source into outline.generated.json. Texts are keys of src/screens/templates/i18n/en.json; key file paths are checked against the template's source and their content is read from it. `featured` groups make the index: the first as an illustrated pair, the rest as row cards; the other groups' pages are reachable by address and listed on the libs screen. `requires` is a key of the `requires.*` strings; `exampleLead: true` takes the example card's lead from `templates.<slug>.exampleLead` instead of the shared one. `indexName: true` titles the template's index card with `templates.<slug>.indexName`.",
  "groups": [
    {
      "id": "start",
      "templates": [
        "template-shell",
        "template-mfe"
      ],
      "featured": true
    },
    {
      "id": "add",
      "templates": [
        "template-design-guardrails"
      ],
      "featured": true
    },
    {
      "id": "site",
      "templates": [
        "template-site",
        "template-site-meta",
        "template-site-brand",
        "template-kit-candidates",
        "template-site-blocks",
        "template-catalogue",
        "template-inbox",
        "template-mfe-demo",
        "template-calendar-demo"
      ]
    }
  ],
  "templates": {
    "template-shell": {
      "kind": "application",
      "requires": "new-project",
      "gives": 3,
      "keyFiles": [
        "frontx-template.json",
        "src-app/app/main.tsx",
        "src-app/app/mfe/bootstrap.ts",
        "src/gts/schemas/extension_screen.v1.json",
        "scripts/dev-all.ts",
        "vite.config.ts"
      ],
      "examples": [
        {
          "screen": "home"
        }
      ],
      "next": [
        {
          "screen": "docs",
          "route": "get-started",
          "label": "next.getStarted"
        }
      ]
    },
    "template-mfe": {
      "kind": "extension",
      "requires": "shell",
      "gives": 3,
      "keyFiles": [
        "frontx-template.json",
        "src-app/mfe_packages/_blank-mfe/mfe.json",
        "src-app/mfe_packages/_blank-mfe/src/lifecycle.tsx",
        "src-app/mfe_packages/_blank-mfe/src/screens/home/HomeScreen.tsx",
        "src-app/mfe_packages/_blank-mfe/src/api/_BlankApiService.ts",
        "src-app/mfe_packages/_blank-mfe/vite.config.ts"
      ],
      "examples": [
        {
          "screen": "mfe-hello-world"
        },
        {
          "screen": "mfe-widgets"
        }
      ],
      "exampleLead": true,
      "next": [
        {
          "screen": "docs",
          "route": "get-started",
          "label": "next.getStarted"
        },
        {
          "screen": "docs",
          "route": "first-change",
          "label": "next.firstChange"
        }
      ]
    },
    "template-design-guardrails": {
      "kind": "rules",
      "requires": "existing-project",
      "gives": 3,
      "keyFiles": [
        "frontx-template.json",
        "DESIGN.md",
        "src-app/verify_packages/design-verify/package.json",
        ".frontx/ai/@gears-frontx/template-design-guardrails/extension.json"
      ],
      "examples": [],
      "next": [
